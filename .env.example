# Copy to .env — do not commit .env (see .gitignore).

# MongoDB (collections: snake_case — see job-pipeline.yaml defaults)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=Kenya
MONGODB_SOURCE_COLLECTION=classified_jobs
MONGODB_TARGET_COLLECTION=ranked_jobs
RERANKER_LOGS_COLLECTION=reranker_logs
RERANKER_STATE_COLLECTION=reranker_state
BULK_WRITE_BATCH_SIZE=100

# --- The backing LLM -----------------------------------------------------------
# Which model runs the three grading/enrichment passes (skill ranking, job attributes,
# occupation-skill relevance). Everything below is optional: with none of it set the
# reranker uses Gemini exactly as it always has, from GEMINI_API_KEY / GEMINI_MODEL.
#
# Pick a shipped provider by alias:
#   gemini            Google GenAI SDK               (default)
#   anthropic         Claude Messages API
#   openai            OpenAI Chat Completions
#   qwen              Qwen on Alibaba DashScope (compatible mode)
#   ollama            local or Ollama Cloud, native /api/chat — Qwen, Llama, Mistral …
#   openai_compatible any other server speaking Chat Completions — vLLM, SGLang,
#                     LM Studio, llama.cpp, Together, Groq …
# RERANKER_LLM_PROVIDER=gemini
#
# …or point at any class implementing app.llm.base.LlmClient, including one outside
# this repo. Set both to reuse a provider's API-key variable with your own class.
# RERANKER_LLM_CLIENT_CLASS=my_pkg.my_module:MyLlmClient
#
# Model id, provider-neutral. Overrides GEMINI_MODEL when both are set. Required for
# every provider except gemini, which falls back to GEMINI_MODEL then gemini-2.5-flash.
# RERANKER_LLM_MODEL=claude-opus-5
#
# API key. Falls back to the provider's own variable: GEMINI_API_KEY / API_KEY,
# ANTHROPIC_API_KEY, OPENAI_API_KEY, DASHSCOPE_API_KEY / QWEN_API_KEY, OLLAMA_API_KEY.
# Leave unset for a local server with no auth (ollama, openai_compatible).
# RERANKER_LLM_API_KEY=
#
# API endpoint. Required for openai_compatible; otherwise the provider's default host
# (ollama: http://localhost:11434, also taken from OLLAMA_BASE_URL / OLLAMA_HOST;
# qwen: the DashScope international region — set the Beijing region here if that is
# where your key was issued).
# RERANKER_LLM_BASE_URL=http://localhost:11434
#
# Sampling and transport. Defaults match the historical Gemini call, so changing none
# of these changes no output. Attempts are clamped to 1..12.
# RERANKER_LLM_TEMPERATURE=0.2
# RERANKER_LLM_MAX_OUTPUT_TOKENS=16384
# RERANKER_LLM_TIMEOUT_S=120
# RERANKER_LLM_MAX_ATTEMPTS=5
#
# Provider-specific extras, merged into the request body as JSON. Useful ones:
#   openai / openai_compatible  {"json_mode": false}          server rejects response_format
#   / qwen                      {"send_temperature": false}   reasoning model rejects temperature
#                               {"max_tokens_field": "max_completion_tokens"}
#   qwen                        {"enable_thinking": true}     needs a streaming-capable setup;
#                                                             off by default, see below
#   ollama                      sampling/runtime knobs go to Ollama's options block, e.g.
#                               {"top_p": 0.9, "num_ctx": 8192, "seed": 7};
#                               {"keep_alive": "10m"} keeps the model resident;
#                               {"format": {…json schema…}} constrains the decode,
#                               {"format": null} disables JSON mode
#   anthropic                   {"anthropic_version": "2023-06-01"}, {"system": "…"}
#   gemini                      any GenerateContentConfig field, e.g. {"top_p": 0.9}
# RERANKER_LLM_OPTIONS={"top_p": 0.9}
#
# Qwen3 models on DashScope think by default and DashScope only serves thinking over
# streaming, so the qwen provider sends enable_thinking=false. Timeouts default to 120s,
# except ollama's 600s — a cold local model spends the first minutes loading weights.

# Gemini. Also used by the job-embedding step, which stays on Gemini regardless of the
# provider above: match_v4's vector space and the whitening artifact are built from
# gemini-embedding-001 (see RERANKER_JOB_EMBEDDING_MODEL below).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-pro-preview
# GEMINI_MODEL=gemini-2.5-flash

# GCP_PROJECT_ID=

# Logging
LOG_LEVEL=INFO

# --- Language ------------------------------------------------------------------
# One image ranks jobs in any registered language (app/languages/). The language selects
# resources/<language>/: taxonomy label CSVs, prompt files, job-attributes schema.
# Resolution: --language CLI / ?language= on POST /rank > RERANKER_LANGUAGE >
# TARGET_LANGUAGE > the language of TARGET_COUNTRY (argentina -> es) > en.
# Accepts a code (en, es) or a locale (AR-es).
# RERANKER_LANGUAGE=es

# Resources (basenames are resolved in resources/<language>/, then resources/en/, then
# resources/ — so a language only ships the files that differ)
JOB_ATTRIBUTES_SCHEMA=job_attributes_reduced.json
CLASSIFIED_LINKED_ENTITY_TYPES=occupation,skill

OCCUPATION_TO_SKILL_RELATIONS_CSV=occupation_to_skill_relations.csv
OCCUPATIONS_CSV=occupations.csv
OCCUPATIONS_CSV_LABEL_COLUMN=PREFERREDLABEL
OCCUPATIONS_CSV_INCLUDE_DESCRIPTIONS=false
OCCUPATIONS_CSV_DESCRIPTION_COLUMN=DESCRIPTION

SKILLS_CSV=skills.csv
SKILLS_CSV_INCLUDE_DESCRIPTIONS=false
SKILLS_CSV_DESCRIPTION_COLUMN=DESCRIPTION

# --- Occupation → skill relations (CSV OCCUPATIONTYPE: escooccupation | localoccupation) ---
# ESCO rows only (smaller graph; excludes localoccupation). Use * or all for no filter.
OCCUPATION_SKILL_RELATION_OCCUPATION_TYPES=escooccupation
# Classifier → relations bridge: esco_uuid_bridge = ESCO from URI/originUUID first, then optional fallback.
OCCUPATION_RELATION_LOOKUP=esco_uuid_bridge
OCCUPATION_RELATION_ESCO_FALLBACK=1

# --- Ranker (values below are logged at start as: Ranker run configuration | …) ---
# Batch cutoff / incremental window (ISO date). Per-country override: KENYA_RERANKER_CUTOFF_DATE etc.
RERANKER_CUTOFF_DATE=2026-01-01
# Slug: zambia | kenya | south_africa | argentina — batch/state key; prompts use country name
# TARGET_COUNTRY=kenya

# Prefer translation.text_en / fields_en on classified_jobs for LLM prompts (Argentina MT).
# Unset, the language decides: en prefers the English MT, es reads the original Spanish
# (prompting in Spanish over English MT text would mix the two). Set to 1 or 0 to force it.
# RERANKER_PREFER_TRANSLATION=1

# --- Argentina -----------------------------------------------------------------
# Same Atlas URI as elsewhere; only the database and the taxonomy resources change.
# The GCP Workflow sets these as env overrides on the Cloud Run Job execution
# (`gcloud run jobs execute llm-reranker --update-env-vars=...`), so one deployed image
# serves every country. Copy this block into the Argentina execution overrides:
#
# TARGET_COUNTRY=argentina
# MONGODB_DATABASE=ArgentinaJobs_V2
# MONGODB_SOURCE_COLLECTION=classified_jobs
# MONGODB_TARGET_COLLECTION=ranked_jobs
#
# The Argentine Spanish taxonomy and the Spanish prompts live in resources/es/ and are
# selected by the language alone — TARGET_COUNTRY=argentina implies RERANKER_LANGUAGE=es,
# so the four taxonomy CSV overrides that used to be needed here are no longer required.
# The ESCO relation graph is identical to the English pack; what differs is the Spanish
# PREFERREDLABEL text that LLM1's skill menu and LLM2's occupation line are built from,
# and the prompt files themselves.
#
# Only set these to pin a specific file, e.g. to rank Argentine jobs against English labels:
# OCCUPATIONS_CSV=en/occupations.csv
# SKILLS_CSV=en/skills.csv

# LLM3 occupation–skills relevance (off = skip call; taxonomy skills still stored unless filtered below)
# Temporarily (FOLD_LLM3_MENU_INTO_LLM1 in app/config.py): no LLM3 call is made; when on, the
# menu below (same limits) is added to LLM1's skill candidates instead.
RERANKER_ENABLE_LLM3=0
# Max skills sent to LLM3 when enabled (0 = no numeric cap after other filters)
RERANKER_LLM3_MAX_MENU_SKILLS=10
# LLM3 prompt only: off | high | medium | low (tier filter on SIGNALLINGVALUELABEL)
RERANKER_LLM3_MENU_SIGNAL_FILTER=off
# 1 = LLM3 menu only skills that also appear on classifier skill entities
RERANKER_LLM3_CLASSIFIER_INTERSECT=0

# Stored occupation→skills: comma tiers to keep — high, medium, low, unlabelled (unset = all). Applies even if LLM3=0.
RERANKER_OCCUPATION_SKILLS_SIGNAL_INCLUDE=

# Batch CLI: parallel workers (disabled with --log-llm*-prompt)
RERANKER_PARALLEL_WORKERS=4
# Resume: skip classified rows whose job_id already exists in ranked_jobs (CLI: --skip-already-ranked)
# RERANKER_SKIP_ALREADY_RANKED=1
# Per job: run LLM1 and LLM2 in parallel (~max of the two, not sum). With parallel workers you may hit Gemini rate limits.
RERANKER_OVERLAP_LLM1_LLM2=1

# Classifier/scraper enrichment copied into classifier_metadata (city, province, sector, zqf_*, isco_*)
# CLASSIFIED_KEYS_LOCATION=city,location,town
# CLASSIFIED_KEYS_COUNTY=province,county,district,region

# Gemini concat job embedding on every ranked job → job_embedding + llm_reranker_meta.embedding
RERANKER_ENABLE_JOB_EMBEDDING=1
# RERANKER_JOB_EMBEDDING_MODEL=gemini-embedding-001
# RERANKER_JOB_EMBEDDING_DIM=3072
# RERANKER_JOB_EMBEDDING_SOURCE=llm_classified_skills
# RERANKER_FAIL_ON_JOB_EMBEDDING_ERROR=0

# Concat whitening (v4 parity): when enabled, job_embedding = whitened, raw_embedding = L2-only
# RERANKER_CONCAT_WHITENING_ENABLED=0
# RERANKER_CONCAT_WHITENING_PATH=resources/concat_whitening_gemini.npz
# RERANKER_CONCAT_WHITENING_REQUIRED=1

# After batch: run work-activities enrichment script (1=on)
RERANKER_RUN_WA_ENRICHMENT=1
# 1 = fail batch if enrichment step errors
RERANKER_FAIL_ON_WA_ENRICHMENT_ERROR=0

CLASSIFIED_LINKED_ENTITY_MIN_SIMILARITY=0.60
CLASSIFIED_LINKED_ENTITY_MIN_SIMILARITY_STRICT=1
CLASSIFIED_LINKED_ENTITY_LABEL_DEDUPE_TYPES=occupation,skills
RERANKER_SYNC_IS_ACTIVE_FROM_CLOSING_DATE=1
