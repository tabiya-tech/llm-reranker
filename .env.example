# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ZambiaJobs
MONGODB_SOURCE_COLLECTION=ClassifiedJobs
MONGODB_TARGET_COLLECTION=RankedJobs

# Flush MongoDB bulk writes every N upserts (default: 100; override with --bulk-batch-size)
BULK_WRITE_BATCH_SIZE=100

# Gemini (GenAI API key — create at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
# GEMINI_MODEL=gemini-2.5-flash

# GCP project id (optional — auto-detected from service account or ADC when not set)
GCP_PROJECT_ID=

# Job attributes JSON (under RESOURCES_DIR or absolute path)
JOB_ATTRIBUTES_SCHEMA=job_attributes_reduced.json

# ESCO occupation → related skills (CSV under RESOURCES_DIR or absolute path)
# Columns auto-detected: occupation_uuid + skill_uuid (URIs OK). Optional: skill_label or skill_name for labels in DB.
OCCUPATION_TO_SKILL_RELATIONS_CSV=occupation_to_skill_relations.csv

API_KEY=
# Tabiya occupations.csv: classifier occupation → Tabiya ID (must match OCCUPATIONID in relations CSV).
OCCUPATIONS_CSV=occupations.csv
# LLM2 job attributes: occupation line from this CSV (first classifier occupation). Label column default: PREFERREDLABEL.
OCCUPATIONS_CSV_LABEL_COLUMN=PREFERREDLABEL
# LLM2: false = taxonomy label only; true = also attach OCCUPATIONS_CSV_DESCRIPTION_COLUMN (e.g. DESCRIPTION).
OCCUPATIONS_CSV_INCLUDE_DESCRIPTIONS=false
OCCUPATIONS_CSV_DESCRIPTION_COLUMN=DESCRIPTION

# Tabiya skills.csv: skill ID / ESCO uuid → PREFERREDLABEL (for occupation_to_skills and ranker labels).
SKILLS_CSV=skills.csv
# LLM1 skill menu: false = labels only; true = also attach text from SKILLS_CSV_DESCRIPTION_COLUMN.
SKILLS_CSV_INCLUDE_DESCRIPTIONS=true
# Column name in skills.csv when include is true (e.g. SCOPEDESCRIPTION, definition).
SKILLS_CSV_DESCRIPTION_COLUMN=

# Classifier linked_entities: which entity_type values to collect (must match classifier JSON).
# Use singular names: skill, occupation (plurals skills/occupations are accepted as aliases).
CLASSIFIED_LINKED_ENTITY_TYPES=occupation,skill

# Logging: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
